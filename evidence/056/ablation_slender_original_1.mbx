variables
 xp in [(-11/10),(11/10)];
 yp in [(-11/10),(11/10)];
 xm in [(-11/10),(11/10)];
 ym in [(-11/10),(11/10)];
 up in [-1,1];
 um in [-1,1];
 B in [(-1/40),(1/40)];
minimize
 -(up-um)/2;
constraints
 xp^2+yp^2>=(81/100);
 xp^2+yp^2<=(121/100);
 xm^2+ym^2>=(81/100);
 xm^2+ym^2<=(121/100);
 up-um>=0;
 (xp^2+yp^2-xm^2-ym^2+up^2-um^2-(-8/5)*(xp-xm)-(2/5)*(yp-ym)-4*(up-um))/4-B>=(-1/80);
 (xp^2+yp^2-xm^2-ym^2+up^2-um^2-(-8/5)*(xp-xm)-(2/5)*(yp-ym)-4*(up-um))/4-B<=(1/80);
 (xp^2+yp^2-xm^2-ym^2+up^2-um^2-(12/5)*(xp-xm)-(2/5)*(yp-ym)-4*(up-um))/4-B>=(-1/40);
 (xp^2+yp^2-xm^2-ym^2+up^2-um^2-(12/5)*(xp-xm)-(2/5)*(yp-ym)-4*(up-um))/4-B<=(1/40);
 (xp^2+yp^2-xm^2-ym^2+up^2-um^2-(1/5)*(xp-xm)-(14/25)*(yp-ym)-4*(up-um))/4-B>=(-1/16);
 (xp^2+yp^2-xm^2-ym^2+up^2-um^2-(1/5)*(xp-xm)-(14/25)*(yp-ym)-4*(up-um))/4-B<=(1/16);
 2*(xp-xm)+0*(yp-ym)>=(-3/40);
 2*(xp-xm)+0*(yp-ym)<=(3/40);
 (9/10)*(xp-xm)+(2/25)*(yp-ym)>=(-3/20);
 (9/10)*(xp-xm)+(2/25)*(yp-ym)<=(3/20);
 (-11/10)*(xp-xm)+(2/25)*(yp-ym)>=(-7/40);
 (-11/10)*(xp-xm)+(2/25)*(yp-ym)<=(7/40);
end
