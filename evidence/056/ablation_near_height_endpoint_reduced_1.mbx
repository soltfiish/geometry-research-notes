variables
 s in [0,1];
 v in [0,(113/12250)];
 q in [0,(1/10)];
 zx in [(-11/10),(11/10)];
 zy in [(-11/10),(11/10)];
minimize
 -s;
constraints
 (zx^2+zy^2)<=(121/100);
 (q+(zx^2+zy^2))^2-(121/100)*(zx^2+zy^2)<=0;
 s*((1/100)+s)-v-q<=(1/40);
 v-(-11/10)*zx-(1/5)*zy>=(-1/200);
 v-(-11/10)*zx-(1/5)*zy<=(1/200);
 v-(9/10)*zx-(-3/10)*zy>=(-1/80);
 v-(9/10)*zx-(-3/10)*zy<=(1/80);
 v-(-1/5)*zx-(6/5)*zy>=(-1/100);
 v-(-1/5)*zx-(6/5)*zy<=(1/100);
end
