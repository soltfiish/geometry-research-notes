variables
 s in [0,1];
 v in [0,(39/985)];
 q in [0,(121/400)];
 zx in [(-11/10),(11/10)];
 zy in [(-11/10),(11/10)];
minimize
 -s;
constraints
 (zx^2+zy^2)<=(121/100);
 (q+(zx^2+zy^2))^2-(121/100)*(zx^2+zy^2)<=0;
 s*(1+s)-v-q<=(3/40);
 v-(-7/5)*zx-(-1/10)*zy>=(-1/16);
 v-(-7/5)*zx-(-1/10)*zy<=(1/16);
 v-(3/5)*zx-(-2/5)*zy>=(-1/40);
 v-(3/5)*zx-(-2/5)*zy<=(1/40);
 v-(2/5)*zx-(8/5)*zy>=(-1/20);
 v-(2/5)*zx-(8/5)*zy<=(1/20);
end
