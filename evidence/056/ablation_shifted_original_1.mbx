variables
 xp in [(-11/10),(11/10)];
 yp in [(-11/10),(11/10)];
 xm in [(-11/10),(11/10)];
 ym in [(-11/10),(11/10)];
 up in [-1,1];
 um in [-1,1];
 B in [(-1/20),(1/20)];
minimize
 -(up-um)/2;
constraints
 xp^2+yp^2>=(81/100);
 xp^2+yp^2<=(121/100);
 xm^2+ym^2>=(81/100);
 xm^2+ym^2<=(121/100);
 up-um>=0;
 (xp^2+yp^2-xm^2-ym^2+up^2-um^2-3*(xp-xm)-(1/2)*(yp-ym)-4*(up-um))/4-B>=(-1/50);
 (xp^2+yp^2-xm^2-ym^2+up^2-um^2-3*(xp-xm)-(1/2)*(yp-ym)-4*(up-um))/4-B<=(1/50);
 (xp^2+yp^2-xm^2-ym^2+up^2-um^2-(11/2)*(xp-xm)--1*(yp-ym)-4*(up-um))/4-B>=(-1/40);
 (xp^2+yp^2-xm^2-ym^2+up^2-um^2-(11/2)*(xp-xm)--1*(yp-ym)-4*(up-um))/4-B<=(1/40);
 (xp^2+yp^2-xm^2-ym^2+up^2-um^2-(7/2)*(xp-xm)-3*(yp-ym)-4*(up-um))/4-B>=(-1/20);
 (xp^2+yp^2-xm^2-ym^2+up^2-um^2-(7/2)*(xp-xm)-3*(yp-ym)-4*(up-um))/4-B<=(1/20);
 (5/4)*(xp-xm)+(-3/4)*(yp-ym)>=(-9/100);
 (5/4)*(xp-xm)+(-3/4)*(yp-ym)<=(9/100);
 (1/4)*(xp-xm)+(5/4)*(yp-ym)>=(-7/50);
 (1/4)*(xp-xm)+(5/4)*(yp-ym)<=(7/50);
 -1*(xp-xm)+2*(yp-ym)>=(-3/20);
 -1*(xp-xm)+2*(yp-ym)<=(3/20);
end
