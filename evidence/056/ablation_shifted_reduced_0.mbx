variables
 s in [0,1];
 v in [0,(139/1120)];
 q in [0,(1/10)];
 zx in [(-11/10),(11/10)];
 zy in [(-11/10),(11/10)];
minimize
 -s;
constraints
 (zx^2+zy^2)<=(121/100);
 (q+(zx^2+zy^2))^2-(121/100)*(zx^2+zy^2)<=0;
 s*(1+s)-v-q<=(1/20);
 v-(3/2)*zx-(1/4)*zy>=(-1/50);
 v-(3/2)*zx-(1/4)*zy<=(1/50);
 v-(11/4)*zx-(-1/2)*zy>=(-1/40);
 v-(11/4)*zx-(-1/2)*zy<=(1/40);
 v-(7/4)*zx-(3/2)*zy>=(-1/20);
 v-(7/4)*zx-(3/2)*zy<=(1/20);
end
