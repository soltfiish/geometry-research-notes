variables
 xp in [(-11/10),(11/10)];
 yp in [(-11/10),(11/10)];
 xm in [(-11/10),(11/10)];
 ym in [(-11/10),(11/10)];
 up in [-1,1];
 um in [-1,1];
 B in [(-1/40),(1/40)];
minimize
 -(up-um)/2;
constraints
 xp^2+yp^2>=(81/100);
 xp^2+yp^2<=(121/100);
 xm^2+ym^2>=(81/100);
 xm^2+ym^2<=(121/100);
 up-um>=0;
 (xp^2+yp^2-xm^2-ym^2+up^2-um^2-(-11/5)*(xp-xm)-(2/5)*(yp-ym)-(101/50)*(up-um))/4-B>=(-1/200);
 (xp^2+yp^2-xm^2-ym^2+up^2-um^2-(-11/5)*(xp-xm)-(2/5)*(yp-ym)-(101/50)*(up-um))/4-B<=(1/200);
 (xp^2+yp^2-xm^2-ym^2+up^2-um^2-(9/5)*(xp-xm)-(-3/5)*(yp-ym)-(101/50)*(up-um))/4-B>=(-1/80);
 (xp^2+yp^2-xm^2-ym^2+up^2-um^2-(9/5)*(xp-xm)-(-3/5)*(yp-ym)-(101/50)*(up-um))/4-B<=(1/80);
 (xp^2+yp^2-xm^2-ym^2+up^2-um^2-(-2/5)*(xp-xm)-(12/5)*(yp-ym)-(101/50)*(up-um))/4-B>=(-1/100);
 (xp^2+yp^2-xm^2-ym^2+up^2-um^2-(-2/5)*(xp-xm)-(12/5)*(yp-ym)-(101/50)*(up-um))/4-B<=(1/100);
 2*(xp-xm)+(-1/2)*(yp-ym)>=(-7/200);
 2*(xp-xm)+(-1/2)*(yp-ym)<=(7/200);
 (9/10)*(xp-xm)+1*(yp-ym)>=(-3/100);
 (9/10)*(xp-xm)+1*(yp-ym)<=(3/100);
 (-11/10)*(xp-xm)+(3/2)*(yp-ym)>=(-9/200);
 (-11/10)*(xp-xm)+(3/2)*(yp-ym)<=(9/200);
end
