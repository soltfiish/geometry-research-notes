variables
 s in [0,1];
 v in [0,(4777/68600)];
 q in [0,(17/80)];
 zx in [(-11/10),(11/10)];
 zy in [(-11/10),(11/10)];
minimize
 -s;
constraints
 (zx^2+zy^2)<=(121/100);
 (q+(zx^2+zy^2))^2-(121/100)*(zx^2+zy^2)<=0;
 s*(1+s)-v-q<=0;
 v--2*zx-(1/3)*zy>=(-1/200);
 v--2*zx-(1/3)*zy<=(1/200);
 v-(3/2)*zx-(-1/2)*zy>=(-1/8);
 v-(3/2)*zx-(-1/2)*zy<=(1/8);
 v-(1/3)*zx-(5/2)*zy>=(-1/100);
 v-(1/3)*zx-(5/2)*zy<=(1/100);
end
