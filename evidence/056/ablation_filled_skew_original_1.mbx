variables
 xp in [(-11/10),(11/10)];
 yp in [(-11/10),(11/10)];
 xm in [(-11/10),(11/10)];
 ym in [(-11/10),(11/10)];
 up in [-1,1];
 um in [-1,1];
 B in [(-3/40),(3/40)];
minimize
 -(up-um)/2;
constraints
 xp^2+yp^2>=0;
 xp^2+yp^2<=(121/100);
 xm^2+ym^2>=0;
 xm^2+ym^2<=(121/100);
 up-um>=0;
 (xp^2+yp^2-xm^2-ym^2+up^2-um^2-(-14/5)*(xp-xm)-(-1/5)*(yp-ym)-4*(up-um))/4-B>=(-1/16);
 (xp^2+yp^2-xm^2-ym^2+up^2-um^2-(-14/5)*(xp-xm)-(-1/5)*(yp-ym)-4*(up-um))/4-B<=(1/16);
 (xp^2+yp^2-xm^2-ym^2+up^2-um^2-(6/5)*(xp-xm)-(-4/5)*(yp-ym)-4*(up-um))/4-B>=(-1/40);
 (xp^2+yp^2-xm^2-ym^2+up^2-um^2-(6/5)*(xp-xm)-(-4/5)*(yp-ym)-4*(up-um))/4-B<=(1/40);
 (xp^2+yp^2-xm^2-ym^2+up^2-um^2-(4/5)*(xp-xm)-(16/5)*(yp-ym)-4*(up-um))/4-B>=(-1/20);
 (xp^2+yp^2-xm^2-ym^2+up^2-um^2-(4/5)*(xp-xm)-(16/5)*(yp-ym)-4*(up-um))/4-B<=(1/20);
 2*(xp-xm)+(-3/10)*(yp-ym)>=(-7/40);
 2*(xp-xm)+(-3/10)*(yp-ym)<=(7/40);
 (9/5)*(xp-xm)+(17/10)*(yp-ym)>=(-9/40);
 (9/5)*(xp-xm)+(17/10)*(yp-ym)<=(9/40);
 (-1/5)*(xp-xm)+2*(yp-ym)>=(-3/20);
 (-1/5)*(xp-xm)+2*(yp-ym)<=(3/20);
end
