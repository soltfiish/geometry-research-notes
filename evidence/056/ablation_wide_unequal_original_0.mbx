variables
 xp in [(-11/10),(11/10)];
 yp in [(-11/10),(11/10)];
 xm in [(-11/10),(11/10)];
 ym in [(-11/10),(11/10)];
 up in [-1,1];
 um in [-1,1];
minimize
 -(up-um)/2;
constraints
 xp^2+yp^2>=(9/25);
 xp^2+yp^2<=(121/100);
 xm^2+ym^2>=(9/25);
 xm^2+ym^2<=(121/100);
 up-um>=0;
 (xp^2+yp^2-xm^2-ym^2+up^2-um^2--4*(xp-xm)-(2/3)*(yp-ym)-4*(up-um))/4>=(-1/200);
 (xp^2+yp^2-xm^2-ym^2+up^2-um^2--4*(xp-xm)-(2/3)*(yp-ym)-4*(up-um))/4<=(1/200);
 (xp^2+yp^2-xm^2-ym^2+up^2-um^2-3*(xp-xm)--1*(yp-ym)-4*(up-um))/4>=(-1/8);
 (xp^2+yp^2-xm^2-ym^2+up^2-um^2-3*(xp-xm)--1*(yp-ym)-4*(up-um))/4<=(1/8);
 (xp^2+yp^2-xm^2-ym^2+up^2-um^2-(2/3)*(xp-xm)-5*(yp-ym)-4*(up-um))/4>=(-1/100);
 (xp^2+yp^2-xm^2-ym^2+up^2-um^2-(2/3)*(xp-xm)-5*(yp-ym)-4*(up-um))/4<=(1/100);
 (7/2)*(xp-xm)+(-5/6)*(yp-ym)>=(-13/50);
 (7/2)*(xp-xm)+(-5/6)*(yp-ym)<=(13/50);
 (7/3)*(xp-xm)+(13/6)*(yp-ym)>=(-3/100);
 (7/3)*(xp-xm)+(13/6)*(yp-ym)<=(3/100);
 (-7/6)*(xp-xm)+3*(yp-ym)>=(-27/100);
 (-7/6)*(xp-xm)+3*(yp-ym)<=(27/100);
end
