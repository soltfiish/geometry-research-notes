variables
 xp in [(-11/10),(11/10)];
 yp in [(-11/10),(11/10)];
 xm in [(-11/10),(11/10)];
 ym in [(-11/10),(11/10)];
 up in [-1,1];
 um in [-1,1];
 B in [(-1/10),(1/10)];
minimize
 -(up-um)/2;
constraints
 xp^2+yp^2>=(81/100);
 xp^2+yp^2<=(121/100);
 xm^2+ym^2>=(81/100);
 xm^2+ym^2<=(121/100);
 up-um>=0;
 (xp^2+yp^2-xm^2-ym^2+up^2-um^2-(-12/5)*(xp-xm)-(3/5)*(yp-ym)-4*(up-um))/4-B>=(-1/80);
 (xp^2+yp^2-xm^2-ym^2+up^2-um^2-(-12/5)*(xp-xm)-(3/5)*(yp-ym)-4*(up-um))/4-B<=(1/80);
 (xp^2+yp^2-xm^2-ym^2+up^2-um^2-(8/5)*(xp-xm)--1*(yp-ym)-4*(up-um))/4-B>=(-3/80);
 (xp^2+yp^2-xm^2-ym^2+up^2-um^2-(8/5)*(xp-xm)--1*(yp-ym)-4*(up-um))/4-B<=(3/80);
 (xp^2+yp^2-xm^2-ym^2+up^2-um^2-(1/2)*(xp-xm)-(13/5)*(yp-ym)-4*(up-um))/4-B>=(-1/40);
 (xp^2+yp^2-xm^2-ym^2+up^2-um^2-(1/2)*(xp-xm)-(13/5)*(yp-ym)-4*(up-um))/4-B<=(1/40);
 2*(xp-xm)+(-4/5)*(yp-ym)>=(-1/10);
 2*(xp-xm)+(-4/5)*(yp-ym)<=(1/10);
 (29/20)*(xp-xm)+1*(yp-ym)>=(-3/40);
 (29/20)*(xp-xm)+1*(yp-ym)<=(3/40);
 (-11/20)*(xp-xm)+(9/5)*(yp-ym)>=(-1/8);
 (-11/20)*(xp-xm)+(9/5)*(yp-ym)<=(1/8);
end
