variables
 s in [0,1];
 v in [0,(701/3200)];
 q in [0,(1/10)];
 zx in [(-11/10),(11/10)];
 zy in [(-11/10),(11/10)];
minimize
 -s;
constraints
 (zx^2+zy^2)<=(121/100);
 (q+(zx^2+zy^2))^2-(121/100)*(zx^2+zy^2)<=0;
 s*(1+s)-v-q<=(1/40);
 v-(-4/5)*zx-(1/5)*zy>=(-1/80);
 v-(-4/5)*zx-(1/5)*zy<=(1/80);
 v-(6/5)*zx-(1/5)*zy>=(-1/40);
 v-(6/5)*zx-(1/5)*zy<=(1/40);
 v-(1/10)*zx-(7/25)*zy>=(-1/16);
 v-(1/10)*zx-(7/25)*zy<=(1/16);
end
